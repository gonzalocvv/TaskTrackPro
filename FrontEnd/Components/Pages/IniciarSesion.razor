@page "/"
@using TaskTrackPro.Backend.Dtos
@inject NavigationManager NavigationManager
@using TaskTrackPro.Backend.Servicios

<PageTitle>Task Track Pro</PageTitle>

<h1 class="mb-4">Iniciar Sesión</h1>


<EditForm Model="@user" OnValidSubmit="IniciarSesionDesdeFormulario">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Email -->
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="user.Email" type="email" />
        <ValidationMessage For="@(() => user.Email)" />
    </div>
    
    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <InputText class="form-control" @bind-Value="user.Contraseña" type="password" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
    
</EditForm>

@if (showSuccessMessage)
{
    <br/>
    <div class="alert alert-success" role="alert">
        Usuario logueado exitosamente
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <br/>
    <div class="alert alert-danger" role="alert">
        @errorMessage 
    </div>
}

@code
{
    LoginDto user;
    private bool showSuccessMessage;
    private string errorMessage;

    [Inject] private UsuarioService usuarioService { get; set; }

    protected override void OnInitialized()
    {
        user = new LoginDto();
    }

    private async Task IniciarSesionDesdeFormulario()
    {
        
        if (string.IsNullOrWhiteSpace(user.Email))
        {
            showSuccessMessage = false;
            errorMessage = "El campo email no puede ser vacio";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(user.Contraseña))
        {
            showSuccessMessage = false;
            errorMessage = "Introduzca una contraseña\n";
            return;
        }
        
        try
        {
            var usuarioDto = new LoginDto { Email = user.Email, Contraseña = user.Contraseña };
            var logged = usuarioService.IniciarSesion(usuarioDto);
            user = new LoginDto();
            showSuccessMessage = true;
            errorMessage = null;
            NavigationManager.NavigateTo("/MisTareas");
        }
        catch (ArgumentNullException)
        {
            showSuccessMessage = false;
            errorMessage = "No existe un usuario registrado con ese email.";
        }
        catch (ArgumentException ex) when (ex.Message.Contains("contraseña"))
        {
            showSuccessMessage = false;
            errorMessage = "Contraseña incorrecta.";
        }
        catch (Exception ex)
        {
            showSuccessMessage = false;
            errorMessage = "Ocurrió un error: " + ex.Message;
        }
    }
}