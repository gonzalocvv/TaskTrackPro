@page "/admin/gestion-usuario"
@using TaskTrackPro.Backend.Dtos
@using TaskTrackPro.Backend.Servicios
@inject UsuarioService UsuarioService

<h1>Gestión de Usuarios</h1>

@if (usuariosRegistrados == null)
{
    <p>Cargando usuarios...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in usuariosRegistrados)
            {
                <tr>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Email</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => SeleccionarUsuario(usuario)">
                            Modificar Contraseña
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (usuarioSeleccionado != null)
{
    <div class="mt-4">
        <h3>Modificar Contraseña</h3>
        <EditForm OnValidSubmit="ModificarContrasena">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Nueva Contraseña</label>
                <InputText class="form-control" @bind-Value="nuevaContrasena" type="password" />
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelarSeleccion">Cancelar</button>
        </EditForm>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-info mt-3">@mensaje</div>
}

@code {
    private List<GetUsuarioDto> usuariosRegistrados;
    private GetUsuarioDto usuarioSeleccionado;
    private string nuevaContrasena;
    private string mensaje;

    protected override void OnInitialized()
    {
        usuariosRegistrados = UsuarioService.GetListaUsuariosRegistrados();
    }

    private void SeleccionarUsuario(GetUsuarioDto usuario)
    {
        usuarioSeleccionado = usuario;
        nuevaContrasena = string.Empty;
        mensaje = string.Empty;
    }

    private void CancelarSeleccion()
    {
        usuarioSeleccionado = null;
        nuevaContrasena = string.Empty;
    }

    private async Task ModificarContrasena()
    {
        if (string.IsNullOrWhiteSpace(nuevaContrasena))
        {
            mensaje = "La contraseña no puede estar vacía.";
            return;
        }

        try
        {
            var dto = new ResetearContrasenaDto
            {
                Email = usuarioSeleccionado.Email,
                NuevaContrasena = nuevaContrasena
            };

            UsuarioService.ResetearContrasenaDefecto(dto);
            mensaje = "Contraseña modificada exitosamente.";
            usuarioSeleccionado = null;
            nuevaContrasena = string.Empty;
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }
}
