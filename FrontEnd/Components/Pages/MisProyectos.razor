@page "/MisProyectos"
@using TaskTrackPro.Backend.Dtos
@using TaskTrackPro.Backend.Servicios
@inject UsuarioService UsuarioService
@inject ProyectoService ProyectoServicio

<h3>Mis proyectos</h3>

@if (proyectos == null || proyectos.Count == 0)
{
    <p><em>No tienes ningÃºn proyecto asignado.</em></p>
}
else
{
    <div class="mb-3">
        <label class="form-label">Seleccione un proyecto</label>
        <select class="form-select" @bind="proyectoNombreSeleccionado" @bind:after="ProyectoCambio">
            <option value="PrimeraFila">Seleccione un proyecto</option>
            @foreach (var proyecto in proyectos)
            {
                if (proyecto.MiembroEmails.Contains(UsuarioService.SesionActual?.Email))
                {
                    <option value="@proyecto.Nombre">@proyecto.Nombre</option>
                }
            }
        </select>
    </div>

    @if (taskCollection.Any())
    {
        <p class="fw-semibold">Duración total (camino crítico): @duracionTotalProyecto horas</p>
        <div style="overflow-x:auto; max-width:100%;">
            <SfGantt DataSource="@taskCollection" Height="300px" Width="900px" TreeColumnIndex="1">
                <GanttTaskFields Id="TaskId" Name="TaskName" StartDate="StartDate" EndDate="EndDate"
                                 Duration="Duration" Progress="Progress" ParentID="ParentId" Dependency="Predecessor" />
                <GanttColumns>
                    <GanttColumn Field="TaskId" HeaderText="ID" Width="100"></GanttColumn>
                    <GanttColumn Field="TaskName" HeaderText="Nombre de la Tarea" Width="250"></GanttColumn>
                    <GanttColumn Field="Critica" HeaderText="Crítica" Width="120"></GanttColumn>
                </GanttColumns>
            </SfGantt>
        </div>
    }
}

@code {
    private List<GetProyectoDto> proyectos = new();
    private List<TaskData> taskCollection = new();
    private string proyectoNombreSeleccionado = "PrimeraFila";
    private int duracionTotalProyecto;

    protected override void OnInitialized()
    {
        var email = UsuarioService.SesionActual?.Email;
        proyectos = ProyectoServicio.GetListaProyectos()
            .Where(p => p.MiembroEmails.Contains(email))
            .ToList();
    }

    private void ProyectoCambio()
    {
        taskCollection.Clear();
        duracionTotalProyecto = 0;

        if (string.IsNullOrWhiteSpace(proyectoNombreSeleccionado) || proyectoNombreSeleccionado == "PrimeraFila")
            return;

        var tareasDto = ProyectoServicio.GetTareasPorNombreProyecto(proyectoNombreSeleccionado);

        var cpm = ProyectoServicio.GetCaminoCritico(proyectoNombreSeleccionado);
        duracionTotalProyecto = cpm.DuracionTotal;
        var criticos = cpm.TitulosCriticos.ToHashSet();

        // El Gantt referencia dependencias por TaskId, no por titulo:
        // primero asignamos un Id a cada tarea y luego armamos los predecesores.
        var idPorTitulo = new Dictionary<string, int>();
        int id = 1;
        foreach (var tarea in tareasDto)
            idPorTitulo[tarea.Titulo] = id++;

        foreach (var tarea in tareasDto)
        {
            var start = tarea.FechaInicio ?? DateTime.Today;

            var predecesores = tarea.TareasQueYoDependoTitulos
                .Where(idPorTitulo.ContainsKey)
                .Select(t => $"{idPorTitulo[t]}FS");
            var predecessor = string.Join(",", predecesores);

            taskCollection.Add(new TaskData
            {
                TaskId = idPorTitulo[tarea.Titulo],
                TaskName = tarea.Titulo,
                StartDate = start,
                EndDate = start.AddHours(tarea.Duracion),
                Duration = Math.Max(1, (int)Math.Ceiling(tarea.Duracion / 8.0)).ToString(),
                Progress = tarea.Estado == "Completada" ? 100 : 0,
                Predecessor = string.IsNullOrEmpty(predecessor) ? null : predecessor,
                ParentId = null,
                Critica = criticos.Contains(tarea.Titulo) ? "Sí" : "No"
            });
        }
    }

    public class TaskData
    {
        public int TaskId { get; set; }
        public string TaskName { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Duration { get; set; }
        public int Progress { get; set; }
        public string Predecessor { get; set; }
        public int? ParentId { get; set; }
        public string Critica { get; set; }
    }
}