@page "/registrarUsuario"
@using Dtos;
@using Microsoft.AspNetCore.Components
@using Servicios
@inject UsuarioService usuarioService;
@attribute [StreamRendering]

<PageTitle>Registrar Usuario</PageTitle>

<h1 class="mb-4">Registrar usuario</h1>

<!-- Formulario con data‑binding y validación -->
<EditForm Model="@user" OnValidSubmit="RegisterAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Nombre -->
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText class="form-control" @bind-Value="user.Nombre" />
    </div>

    <!-- Apellido -->
    <div class="mb-3">
        <label class="form-label">Apellido</label>
        <InputText class="form-control" @bind-Value="user.Apellido" />
    </div>

    <!-- Email -->
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="user.Email" type="email" />
    </div>

    <!-- Fecha de nacimiento -->
    <div class="mb-3">
        <label class="form-label">Fecha de nacimiento</label>
        <InputDate class="form-control" @bind-Value="user.FechaNacimiento" />
    </div>

    <!-- Contraseña -->
    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <InputText class="form-control" @bind-Value="user.Contraseña"
                   type="password" minlength="8" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Registrarse</button>
</EditForm>

@if (showSuccessMessage)
{
    <br/>
    <div class="alert alert-success" role="alert">
        Usuario registrado existosamente
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <br/>
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}


@code {
    CreateUsuarioDto user;
    private bool showSuccessMessage = false;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        user = new CreateUsuarioDto();
    }
    
    private async Task RegisterAsync()
    {
        if (string.IsNullOrWhiteSpace(user.Nombre))
        {
            showSuccessMessage = false;
            errorMessage = "El nombre no puede ser vacio";
            return;
        }

        if (string.IsNullOrWhiteSpace(user.Apellido))
        {
            showSuccessMessage = false;
            errorMessage = "El apellido no puede ser vacio";
            return;
        }

        if (string.IsNullOrWhiteSpace(user.Email))
        {
            showSuccessMessage = false;
            errorMessage = "El email no puede ser vacio";
            return;
        }

        if (string.IsNullOrWhiteSpace(user.Contraseña))
        {
            showSuccessMessage = false;
            errorMessage = "La contraseña no puede ser vacia";
            return;
        }

        try
        {
            var UsuarioDto = new CreateUsuarioDto
            {
                Nombre = user.Nombre,
                Apellido = user.Apellido,
                Email = user.Email,
                FechaNacimiento = user.FechaNacimiento,
                Contraseña = user.Contraseña
            };
            usuarioService.CrearUsuario(UsuarioDto);
            showSuccessMessage = true;
            errorMessage = null;

            user.Nombre = string.Empty;
            user.Apellido = string.Empty;
            user.Email = string.Empty;
            user.FechaNacimiento = DateTime.MinValue;
            user.Contraseña = string.Empty;
        }
        catch (Exception e)
        {
            showSuccessMessage = false;
            errorMessage = e.Message;
        }
    }

}