@page "/registrarProyecto"
@using Dtos
@using Servicios
@inject UsuarioService UsuarioService
@inject ProyectoService ProyectoService
@attribute [StreamRendering]

<PageTitle>Crear proyecto</PageTitle>

<h1 class="mb-4">Crear proyecto</h1>

<EditForm Model="@nuevoProyecto" OnValidSubmit="CrearProyectoDesdeFormulario">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Nombre -->
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText class="form-control" @bind-Value="nuevoProyecto.Nombre" />
    </div>

    <!-- Descripción -->
    <div class="mb-3">
        <label class="form-label">Descripción (máx. 400 caracteres)</label>
        <InputTextArea class="form-control"
                       rows="4" maxlength="400"
                       @bind-Value="nuevoProyecto.Descripcion" />
    </div>

    <!-- Fecha de inicio -->
    <div class="mb-3">
        <label class="form-label">Fecha de inicio estimada</label>
        <InputDate class="form-control" @bind-Value="nuevoProyecto.FechaInicio" />
    </div>

    <!-- Miembros -->
    <div class="mb-3">
        <label class="form-label">Miembros del proyecto</label>
        <select multiple class="form-select" style="height:200px"
                @bind="usuariosSeleccionados">
            @foreach (var u in usuariosRegistrados)
            {
                <option value="@u.Email">@u.Nombre (@u.Email)</option>
            }
        </select>
        <div class="form-text">Mantén Ctrl / ⌘ para seleccionar varios.</div>
    </div>

    <button type="submit" class="btn btn-success w-100">Crear proyecto</button>
</EditForm>

@if (!string.IsNullOrEmpty(mensaje))
{
    <br />
    <div class="alert alert-success">@mensaje</div>
}

@code {
    private CrearProyectoDto nuevoProyecto;
    private List<string> usuariosSeleccionados = new();
    private List<GetUsuarioDto> usuariosRegistrados = new();
    private string mensaje;

    protected override async Task OnInitializedAsync()
    {
        usuariosRegistrados = await UsuarioService.GetUsuariosRegistrados();
    }

    private async Task CrearProyectoDesdeFormulario()
    {
        var administrador = UsuarioService.SesionActual;
        var miembros = usuariosSeleccionados.Select(mail => UsuarioService.GetUsuarioPorEmail(mail)).ToList();
        if (!miembros.Contains(administrador)) 
            miembros.Add(administrador);
        
        miembros.ForEach(nuevoProyecto.AgregarMiembro);

        await ProyectoService.CrearProyecto(nuevoProyecto);
        mensaje = "Proyecto creado con éxito.";
        nuevoProyecto = new();          // limpia formulario
        usuariosSeleccionados.Clear();  // limpia selección
    }
}