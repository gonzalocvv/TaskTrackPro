@page "/crearTarea"
@using Microsoft.IdentityModel.Tokens
@using TaskTrackPro.Backend.Dtos
@using TaskTrackPro.Backend.Servicios
@inject ProyectoService ProyectoService
@inject UsuarioService UsuarioService
@inject TareaService   TareaService
@inject RecursoService RecursoService
@inject NavigationManager NavigationManager

<PageTitle>Crear tarea</PageTitle>

<h1 class="mb-4">Crear tarea</h1>

<EditForm Model="@tareaForm" OnValidSubmit="GuardarTarea">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Seleccione un proyecto</label>
        <select class="form-select" @bind="tareaForm.ProyectoNombre" @bind:after="ProyectoCambio">
            <option value="PrimeraFila">Seleccione un proyecto</option>
            @foreach (var proyecto in proyectos)
            {
                if (proyecto.MiembroEmails.Contains(UsuarioService.SesionActual?.Email))
                {
                    <option value="@proyecto.Nombre">@proyecto.Nombre</option>
                }
            }
        </select>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Título</label>
        <InputText class="form-control" @bind-Value="tareaForm.Titulo" />
    </div>

    
    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <InputTextArea class="form-control" rows="3"
                       @bind-Value="tareaForm.Descripcion" />
    </div>

    
    <div class="mb-3">
        <label class="form-label">Fecha de inicio (opcional)</label>
        <InputDate class="form-control" @bind-Value="tareaForm.FechaInicio" />
    </div>

    
    <div class="mb-3">
        <label class="form-label">Duración (horas)</label>
        <InputNumber class="form-control" @bind-Value="tareaForm.Duracion" />
    </div>

    
    <div class="mb-3">
        <label class="form-label">Usuarios asignados</label>
        <select multiple class="form-select" style="height:200px"
                @bind="emailsSeleccionados">
            @foreach (var u in usuarios)
            {
                <option value="@u.Email">@u.Nombre (@u.Email)</option>
            }
        </select>
        <div class="form-text">Ctrl / ⌘ para seleccionar varios.</div>
    </div>
    @if (!tareasDelProyecto.IsNullOrEmpty())
    {
        <div class="mb-3">
            <label class="form-label">Depende de</label>
            <select multiple class="form-select" style="height:180px"
                    @bind="titulosSeleccionados">
                @foreach (var t in tareasDelProyecto.Where(t => t.Estado != "Completada"))
                {
                    <option value="@t.Titulo">@t.Titulo (@t.Estado) (@t.Duracion)</option>
                }
            </select>
            <div class="form-text">Ctrl/⌘ para seleccionar varias.</div>
        </div>
    }

    @if (recursosDisponibles.Any())
    {
        <div class="mb-3">
            <label class="form-label">Recursos</label>
            <select multiple class="form-select" style="height:150px" @bind="recursosSeleccionados">
                @foreach (var r in recursosDisponibles)
                {
                    <option value="@r.Nombre">@r.Nombre (@r.Tipo) - cap. @r.Cantidad</option>
                }
            </select>
            <div class="form-text">Ctrl/⌘ para seleccionar varios.</div>
        </div>
    }

    <button type="submit" class="btn btn-primary w-100">Crear tarea</button>
</EditForm>

@if (showSuccessMessage)
{
    <br/>
    <div class="alert alert-success" role="alert">
        Tarea registrada con éxito
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <br/>
    <div class="alert alert-danger" role="alert">
        @errorMessage 
    </div>
}

@code {
    private CrearTareaDto tareaForm = new();
    private List<GetProyectoDto> proyectos = new();
    private List<GetTareaDto>    tareasDelProyecto = new(); 
    private List<GetUsuarioDto> usuarios  = new();
    private string[] emailsSeleccionados  = Array.Empty<string>();
    private string[] titulosSeleccionados = Array.Empty<string>();
    private List<GetRecursoDto> recursosDisponibles = new();
    private string[] recursosSeleccionados = Array.Empty<string>();
    
    private string errorMessage;
    private bool showSuccessMessage = false;
    
    private void ProyectoCambio()
    {
        if (string.IsNullOrWhiteSpace(tareaForm.ProyectoNombre) ||
            tareaForm.ProyectoNombre == "PrimeraFila")
        {
            tareasDelProyecto   = new();
            usuarios            = new();
            emailsSeleccionados = Array.Empty<string>();
            return;
        }

        tareasDelProyecto = ProyectoService
            .GetTareasPorNombreProyecto(tareaForm.ProyectoNombre)
            .Where(t => t.Estado != "Completada")
            .ToList();

        var proyectoSel = proyectos
            .FirstOrDefault(p => p.Nombre == tareaForm.ProyectoNombre);

        if (proyectoSel is not null)
        {
            var miembros = proyectoSel.MiembroEmails;
            usuarios = UsuarioService.GetListaUsuariosRegistrados()
                .Where(u => miembros.Contains(u.Email))
                .ToList();
        }
        else
        {
            usuarios = new();
        }

        emailsSeleccionados                = Array.Empty<string>();
        tareaForm.TareasQueYoDependoTitulos = new List<string>();

        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        if (UsuarioService.SesionActual is null)
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }
        proyectos = ProyectoService.GetListaProyectos();
        usuarios  = new();
        recursosDisponibles = RecursoService.GetListaRecursos();
    }

    private void GuardarTarea()
    {
        if (UsuarioService.SesionActual is null)
        {
            errorMessage = "Debe iniciar sesión para crear proyectos.";
            return;
        }
        if (string.IsNullOrWhiteSpace(tareaForm.ProyectoNombre) || tareaForm.ProyectoNombre == "PrimeraFila")
        {
            errorMessage = "Debe seleccionar un proyecto.";
            return;
        }
        var actual = UsuarioService.SesionActual.Email;
        if (!emailsSeleccionados.Contains(actual))
            emailsSeleccionados = emailsSeleccionados.Append(actual).ToArray();
        
        tareaForm.UsuariosAsignadosEmails = emailsSeleccionados.ToList();
        try
        {
            tareaForm.TareasQueYoDependoTitulos = titulosSeleccionados.ToList();
            var tituloCreado = tareaForm.Titulo;
            TareaService.CrearTarea(tareaForm);

            foreach (var nombreRecurso in recursosSeleccionados)
            {
                RecursoService.AsignarRecursoATarea(tituloCreado, nombreRecurso);
            }

            showSuccessMessage = true;

            tareaForm = new();
            tareaForm.FechaInicio = DateTime.Today;
            emailsSeleccionados = Array.Empty<string>();
            titulosSeleccionados = Array.Empty<string>();
            recursosSeleccionados = Array.Empty<string>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}