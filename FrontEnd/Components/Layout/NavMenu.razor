@inject NavigationManager NavigationManager

<div class="nav-scrollable d-flex flex-column vh-100"
     onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column flex-grow-1">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="iniciarSesion" >
                <span class="bi bi-box-arrow-in-right prueba" aria-hidden="true"></span> Iniciar Sesión
            </NavLink>
        </div>

       

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="registrarUsuario">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Registrar Usuario
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="registrarProyecto">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Registrar Proyecto
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="crearTarea">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Crear Tarea
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/tareas">
                <span class="bi bi-list-check" aria-hidden="true"></span> Mis Tareas
            </NavLink>
        </div>
        
        <div class="flex-grow-1"></div>
        
        <div class="text-center mb-3">
            <button class="btn btn-light text-dark px-4" @onclick="ShowConfirm">
                Cerrar sesión
            </button>
        </div>
        
        @if (showConfirm)
        {
            <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">TaskTrackPro</h5>
                            <button type="button" class="btn-close" aria-label="Close" @onclick="HideConfirm"></button>
                        </div>
                        <div class="modal-body">
                            <p>¿Está seguro de que desea cerrar sesión?</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="HideConfirm">No</button>
                            <button class="btn btn-primary" @onclick="ConfirmLogout">Sí</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        
    </nav>
</div>

@code {
            private bool showConfirm = false;

            void ShowConfirm() => showConfirm = true;
            void HideConfirm() => showConfirm = false;

            void ConfirmLogout()
            {
                NavigationManager.NavigateTo("/IniciarSesion", forceLoad: true);
            }
        }
